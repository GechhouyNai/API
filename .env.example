# Admin-only API key for Bakong token management endpoint
# openssl rand -hex 32
ADMIN_API_KEY=replace-with-a-random-secret

# Bakong Open API: SIT/testing or production
BAKONG_ENV=testing
BAKONG_API_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_EMAIL=

# ABA-registered merchant details (replace with the real values from ABA)
BAKONG_ACCOUNT_ID=021403414
BAKONG_MERCHANT_ID=2125220
BAKONG_ACQUIRING_BANK=ABA
BAKONG_MERCHANT_NAME=Coffee Shop
BAKONG_MERCHANT_CITY=Phnom Penh

# Orders are priced in USD; KHQR will be generated in KHR
BAKONG_ORDER_CURRENCY=USD
BAKONG_KHR_PER_USD=4100
BAKONG_QR_EXPIRY_MINUTES=10

JWT_SECRET=replace-with-a-long-random-secret
TOKEN_DAYS=7
REQUIRE_LOGIN_FOR_ORDERS=true
RESET_CODE_IN_RESPONSE=false

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/coffee_shop?retryWrites=true&w=majority
# Server
PORT=8080

# Bakong Open API
# Production: https://api-bakong.nbc.gov.kh
# Sandbox/SIT: https://sit-api-bakong.nbc.gov.kh
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh

# Your Bakong Merchant / Individual Info
BAKONG_ACCOUNT_ID=your_real_aba_bakong_account_id
BAKONG_MERCHANT_NAME=Coffee Shop
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD

# Optional: Used to auto-renew token via POST /v1/renew_token
BAKONG_EMAIL=
