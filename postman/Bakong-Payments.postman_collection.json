{
  "info": {
    "name": "Coffee Backend API - Bakong KHQR",
    "description": "Bakong SIT/testing payment flow for the existing Dart Frog Coffee API. Set collection variables before testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080/api"},
    {"key":"token","value":""},
    {"key":"adminApiKey","value":""},
    {"key":"orderId","value":""},
    {"key":"md5","value":""},
    {"key":"paymentId","value":""},
    {"key":"bakongToken","value":""},
    {"key":"bakongEmail","value":""}
  ],
  "item": [
    {
      "name":"1. Check Bakong token status (admin)",
      "request":{"method":"GET","header":[{"key":"x-admin-api-key","value":"{{adminApiKey}}"}],"url":"{{baseUrl}}/payments/bakong/token"}
    },
    {
      "name":"2. Save Bakong Open API token (admin)",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-admin-api-key","value":"{{adminApiKey}}"}],"body":{"mode":"raw","raw":"{\n  \"token\": \"{{bakongToken}}\",\n  \"email\": \"{{bakongEmail}}\"\n}"},"url":"{{baseUrl}}/payments/bakong/token"}
    },
    {
      "name":"3. Renew Bakong token (admin, optional)",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"x-admin-api-key","value":"{{adminApiKey}}"}],"body":{"mode":"raw","raw":"{\n  \"renew\": true,\n  \"email\": \"{{bakongEmail}}\"\n}"},"url":"{{baseUrl}}/payments/bakong/token"}
    },
    {
      "name":"4. Create KHQR for an order (user JWT)",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"orderId\": \"{{orderId}}\"\n}"},"url":"{{baseUrl}}/payments/bakong/create"},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('KHQR created', function () { pm.response.to.have.status(201); });","const body = pm.response.json(); const data = body.data || body; if (data.md5) pm.collectionVariables.set('md5', data.md5); if (data._id) pm.collectionVariables.set('paymentId', data._id); else if (data.paymentId) pm.collectionVariables.set('paymentId', data.paymentId);"]}}]
    },
    {
      "name":"5. Verify payment by MD5 (user JWT)",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"md5\": \"{{md5}}\"\n}"},"url":"{{baseUrl}}/payments/bakong/verify"}
    },
    {
      "name":"6. Get payment by ID (user JWT)",
      "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/payments/{{paymentId}}"}
    },
    {
      "name":"7. Check payment by ID (user JWT)",
      "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/payments/{{paymentId}}/check"}
    }
  ]
}
